generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  UPCOMING
  PAST
}

enum MediaType {
  IMAGE
  VIDEO
}

model Event {
  id     String      @id @default(cuid())
  slug   String      @unique
  status EventStatus @default(DRAFT)
  // The one event shown at the static, pre-printed /event URL (QR codes).
  // Only one Event should have this true at a time; enforced in application code.
  isCurrent Boolean @default(false)

  title          String
  eventDate      DateTime?
  location       String?
  partnerName    String?
  partnerLogoUrl String?

  heroEyebrow        String?
  heroHeadline       String
  heroHeadlineAccent String?
  heroSubcopy        String?
  heroBadges         String[]
  trustBarItems      String[]

  offers       Json
  packageParts Json
  howItWorks   Json

  helpPhone String?
  helpEmail String?

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media Media[]

  @@index([status, eventDate])
}

model Media {
  id      String    @id @default(cuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type    MediaType

  url          String
  thumbnailUrl String?
  publicId     String
  caption      String?
  order        Int     @default(0)

  createdAt DateTime @default(now())

  @@index([eventId, order])
  @@index([type])
}

// An RSVP-able event (e.g. a mosque session). Content lives in lib/rsvp.ts;
// this row holds what admins change live: how many priority spots exist.
model RsvpEvent {
  slug             String   @id
  priorityCapacity Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rsvps Rsvp[]
}

model Rsvp {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  eventSlug String
  event     RsvpEvent @relation(fields: [eventSlug], references: [slug], onDelete: Cascade)

  passNumber Int
  priority   Boolean

  name      String
  email     String
  phone     String
  partySize Int     @default(1)

  marketingConsent Boolean @default(false)
  consentText      String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  checkedInAt DateTime?

  @@unique([eventSlug, passNumber])
  @@unique([eventSlug, email])
  @@index([eventSlug, createdAt])
}
